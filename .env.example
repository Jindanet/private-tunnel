# Start here / เริ่มจากตั้งค่าโดเมนสองรายการนี้
# Admin + client connection host (exact hostname, no wildcard)
PRIMARY_DOMAIN=admin.example.com
# Public websites use names such as demo.apps.example.com
TUNNEL_DOMAIN=apps.example.com

# Legacy shared-key compatibility only; disabled by default below.
# Issue individual client keys from admin Settings for normal use. Those keys
# are generated once and only their hashes are stored in DATA_DIR/client-keys.json.
# Empty on FIRST boot = generate a legacy shared key stored in the database.
# Never commit the real .env, data directory or database.
# For a supplied key, use a cryptographically random secret: 32-4096 visible ASCII
# characters without whitespace. Length alone does not establish randomness.
# Placeholder prefixes your-/your_, replace-/replace_, change-/change_ and
# example-/example_ are rejected (case insensitive). Invalid nonempty values
# prevent startup, even when the database already contains a key.
TUNNEL_TOKEN=
# Empty on first boot = generate DATA_DIR/admin-bootstrap.txt (private password).
# Sign in locally, then change the password in the dashboard.
# A supplied bootstrap password must contain 10-1024 characters and not be a known placeholder.
# Used/validated only when neither the current nor legacy admin password exists
# in the database. Existing installations ignore this value and keep their DB password.
DASHBOARD_PASSWORD=

# Internal listeners: keep loopback when Nginx runs on this machine.
# Do not expose these ports directly to the internet.
INTERNAL_HOST=127.0.0.1
WS_PORT=8080
DASHBOARD_PORT=8081
PROXY_PORT=8082

# PREOPEN these TCP ports in host/cloud firewalls and any router/NAT before use.
# This declares allowed ports; it does not discover rules or prove internet access.
# Default is 30000-40000 inclusive, skipping occupied ports; no extra config is
# needed if that range is already open. All eligible ports full = creation fails.
# Fallback order: 40001-65535, then 1024-29999; each requires explicit inclusion
# and is tried only after all eligible ports in earlier ranges are unavailable.
# Only after opening the additional ports, an example expanded policy is:
# TCP_ALLOWED_PORTS=30000-65535,25000-25010
# Never use privileged ports 1-1023 or ephemeral/port-0 fallback.
# Obsolete TCP_PORT_MIN/TCP_PORT_MAX do not configure allocation.
TCP_ALLOWED_PORTS=30000-40000
# Test the assigned host:port externally; it can change on reconnect.
# Public TCP traffic has no built-in TLS or visitor authentication.
# Optional local interface IP; empty retains the OS default interfaces.
TCP_BIND_HOST=
# Empty allows every visitor. Set comma-separated IPs/CIDRs to restrict TCP access.
# Example: 203.0.113.10,198.51.100.0/24,2001:db8:1234::/48
TCP_VISITOR_ALLOWLIST=
# Manage firewall rules separately. Run PrivateTunnel without root/Administrator.
# Legacy true aborts TCP setup if opening its local rule fails; it cannot verify
# upstream cloud firewalls or NAT, and does not replace TCP_ALLOWED_PORTS.
AUTO_FIREWALL=false

# Authentication compatibility switches: keep all false on networked servers.
ALLOW_SHARED_TUNNEL_TOKEN=false
ALLOW_UNAUTHENTICATED_TUNNELS=false
ALLOW_LEGACY_QUERY_TOKEN=false
# Modern receive credit is required by default. False permits unsafe legacy v1
# data-plane behavior and is intended only for a trusted migration environment.
REQUIRE_DATA_TRANSPORT_V4=true
# Per-request inactivity, reset on upload/response progress; not total duration.
HTTP_IDLE_TIMEOUT_MS=30000

# Store request metadata (not bodies/full headers). Queries/fragments are redacted.
# false disables NEW metadata logging; old rows/backups must be handled separately.
REQUEST_LOGGING=true

# SQLite is the default; DATA_DIR must be writable by the service account.
# SQLITE_PATH takes precedence over DATA_DIR. Update both when moving state.
# With SQLITE_PATH/DB_PATH omitted, SQLite defaults to DATA_DIR/tunnel.db.
DATA_DIR=./data
DB_PROVIDER=sqlite
SQLITE_PATH=./data/tunnel.db

# Optional database mirrors are retained for compatibility, disabled by default.
# A mirror is not a backup or automatic failover. Failed non-strict writes can diverge.
DB_SYNC_TARGETS=
DB_SYNC_STRICT=true
# NODE_ENV=production rejects non-primary DB_SYNC_TARGETS entirely.
# Enable only for a planned, backed-up migration to an empty target backend.
DB_BOOTSTRAP_SYNC=false

# Optional MySQL backend (DB_PROVIDER=mysql), with a dedicated database user.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=privatetunnel
MYSQL_PASSWORD=
MYSQL_DATABASE=privatetunnel

# Domains/access key/admin password are seeded into the database on FIRST boot.
# The control root initially uses /_private-tunnel; it is not seeded from .env.
# Change stored settings in the dashboard afterward; .env does not replace them.
# A legacy invalid stored key blocks tunnel authentication until rotated; the
# administrator can still sign in, but must rotate that key before saving Settings.
# Legacy SQLite path alias: DB_PATH=./data/tunnel.db
